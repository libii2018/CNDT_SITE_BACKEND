# =====================================================================
# Copiez ce fichier en `.env` (à côté de docker-compose.yml) puis
# renseignez les valeurs. Le `.env` n'est jamais versionné (.gitignore).
#   cp .env.example .env
# =====================================================================

# --- Application ---
# Générez une clé :  docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changez-moi
MYSQL_PASSWORD=changez-moi-aussi
DB_DATABASE=cndt_api
DB_USERNAME=cndt

# --- Compte administrateur (créé uniquement au premier seed) ---
ADMIN_PASSWORD=changez-ce-mot-de-passe

# --- Alertes e-mail (formulaire de contact) ---
# MAIL_MAILER=log  → les alertes partent dans les logs du conteneur API.
# MAIL_MAILER=smtp  → configurez les variables ci-dessous.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@cndtcameroun.cm
MAIL_FROM_NAME="CNDT"
MAIL_ENCRYPTION=tls
# Adresse qui reçoit une alerte à chaque message de contact :
MAIL_ALERT_TO=
